# Copy to .env and fill in. Never commit .env to Git.
PORT=3000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Where the SQLite file lives
DB_FILE=./data/register.db
# Only set true on a demo machine. Lets the mentor wipe attendance/marks.
ALLOW_RESET=false
